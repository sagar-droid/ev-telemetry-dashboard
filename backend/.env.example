PORT=4000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=ev_vehicle

# Redis current vehicle state
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_CURRENT_STATE_TTL_SECONDS=60

# Historical telemetry retention
TELEMETRY_RAW_RETENTION_DAYS=7

# Telemetry history store: mysql (default) or timescale
TELEMETRY_STORE=timescale
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=
TIMESCALE_DB=ev_telemetry

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# CORS
CLIENT_ORIGIN=http://localhost:3000

# Telemetry simulator (set to "false" once you have real bikes sending data)
ENABLE_SIMULATOR=true
SIMULATOR_INTERVAL_MS=1500
